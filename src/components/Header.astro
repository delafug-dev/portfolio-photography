---
import { profile } from "@/data/profile";

const links = [
    { href: "/", label: "Gallery" },
    { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header
    id="site-header"
    data-open="false"
    class="group sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur transition-colors"
>
    <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 lg:px-6"
    >
        <a
            href="/"
            class="flex shrink-0 items-center gap-2.5 sm:gap-3"
            aria-label={`${profile.brand} — home`}
        >
            <!-- Dos logos alternados por CSS: cambiar el src con JS provocaba un
                 parpadeo del logo equivocado al cargar. -->
            <img
                src="/logo.svg"
                alt=""
                width="36"
                height="36"
                class="h-8 w-8 sm:h-9 sm:w-9 dark:hidden"
            />
            <img
                src="/logo-dark.svg"
                alt=""
                width="36"
                height="36"
                class="hidden h-8 w-8 sm:h-9 sm:w-9 dark:block"
            />
            <span class="font-serif text-base tracking-tight sm:text-lg lg:text-xl">
                Devlafug<span class="hidden text-muted sm:inline"> Photography</span>
            </span>
        </a>

        <div class="flex items-center gap-1 sm:gap-2">
            <!-- Navegación inline a partir de tablet -->
            <nav aria-label="Main" class="hidden md:block">
                <ul class="flex items-center gap-6 lg:gap-8">
                    {
                        links.map(({ href, label }) => (
                            <li>
                                <a
                                    href={href}
                                    aria-current={path === href ? "page" : undefined}
                                    class:list={[
                                        "text-sm transition-colors hover:text-accent",
                                        path === href
                                            ? "text-ink underline decoration-accent decoration-1 underline-offset-8"
                                            : "text-muted",
                                    ]}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <button
                id="theme-toggle"
                type="button"
                class="rounded-full p-2 transition-colors hover:bg-black/10 dark:hover:bg-white/10"
                aria-label="Toggle theme"
            >
                <svg
                    class="hidden h-5 w-5 dark:block"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                >
                    <path
                        fill-rule="evenodd"
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                        clip-rule="evenodd"></path>
                </svg>
                <svg
                    class="h-5 w-5 dark:hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
            </button>

            <!-- Botón de menú solo en móvil -->
            <button
                id="menu-toggle"
                type="button"
                aria-controls="mobile-menu"
                aria-expanded="false"
                aria-label="Open menu"
                class="rounded-full p-2 transition-colors hover:bg-black/10 md:hidden dark:hover:bg-white/10"
            >
                <svg
                    class="h-5 w-5 group-data-[open=true]:hidden"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
                <svg
                    class="hidden h-5 w-5 group-data-[open=true]:block"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Panel desplegable. El truco de grid-rows 0fr → 1fr permite animar la
         altura sin saber cuánto mide el contenido. -->
    <div
        id="mobile-menu"
        inert
        class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-data-[open=true]:grid-rows-[1fr] md:hidden"
    >
        <div class="overflow-hidden">
            <nav aria-label="Main" class="border-t border-line px-4 py-2">
                <ul>
                    {
                        links.map(({ href, label }) => (
                            <li class="border-b border-line last:border-b-0">
                                <a
                                    href={href}
                                    aria-current={path === href ? "page" : undefined}
                                    class:list={[
                                        "block py-3.5 text-base transition-colors hover:text-accent",
                                        path === href ? "text-ink" : "text-muted",
                                    ]}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById("site-header");
    const menuToggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    function setMenu(open: boolean) {
        if (!header || !menuToggle || !menu) return;

        header.dataset.open = String(open);
        menuToggle.setAttribute("aria-expanded", String(open));
        menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");

        // inert saca los enlaces ocultos del recorrido del tabulador: sin esto
        // se puede tabular a un menú cerrado que no se ve.
        if (open) menu.removeAttribute("inert");
        else menu.setAttribute("inert", "");
    }

    menuToggle?.addEventListener("click", () => {
        setMenu(header?.dataset.open !== "true");
    });

    // Al navegar dentro de la misma página o pulsar Escape, se cierra.
    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
    });

    // Si se ensancha la ventana hasta el layout de escritorio, el panel sobra.
    window
        .matchMedia("(min-width: 768px)")
        .addEventListener("change", (event) => {
            if (event.matches) setMenu(false);
        });

    // El tema ya viene aplicado desde el <head> del Layout, así que aquí solo
    // queda alternarlo. Los iconos y el logo cambian por CSS con la variante dark:.
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    });
</script>
